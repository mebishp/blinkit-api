# All settings are optional; prefix with BLINKIT_
BLINKIT_UPSTREAM_TIMEOUT=20
BLINKIT_MAX_CONCURRENCY=4
BLINKIT_MAX_UPSTREAM_ITEMS=120
BLINKIT_CACHE_TTL_LISTING=300
BLINKIT_CACHE_TTL_PRODUCT=300
BLINKIT_CACHE_TTL_CATEGORIES=21600
BLINKIT_CACHE_TTL_GEOCODE=86400
# Used to bias address/pincode autosuggest when the caller gives no coordinates
BLINKIT_DEFAULT_LAT=28.6139
BLINKIT_DEFAULT_LON=77.2090
